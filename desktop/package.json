{
  "name": "frameweave-desktop",
  "version": "0.3.12",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:web": "npm --prefix ../web run build",
    "integrity": "node scripts/embed-integrity.cjs",
    "pack": "npm run build:web && npm run integrity && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.frameweave.app",
    "productName": "FrameWeave",
    "asar": true,
    "asarUnpack": [],
    "removePackageScripts": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "integrity.json",
      "build/icon.png",
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "FrameWeave-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "拾帧 FrameWeave",
      "perMachine": false,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "nsis-fixes.nsh"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "extraResources": [
      {
        "from": "../backend/packaging/dist/backend-dist",
        "to": "backend-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://shouquan.frameweave.top/update"
      },
      {
        "provider": "github",
        "owner": "xsk159357",
        "repo": "frameweave-desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}