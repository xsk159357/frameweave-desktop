{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frameweave.top/schemas/manifest-v2.json",
  "title": "FrameWeave 插件 manifest v2 契约",
  "description": "插件唯一识别入口 manifest.json 的结构契约（G1-G10 校验门的权威声明）。跨字段语义（op 白名单递归、端口重名、permission 作用域、v1 兼容注入）由 app/plugin/manifest_v2.py 实施，本文件覆盖结构层。",
  "type": "object",
  "required": [
    "schema_version",
    "engine_api",
    "type_id",
    "title",
    "category",
    "description",
    "version",
    "kind",
    "inputs",
    "outputs",
    "params"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "G1: manifest 格式版本，缺失 = v1 兼容模式触发条件（不写盘）"
    },
    "engine_api": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "G1: 插件声明的引擎 ABI 主.次版本（当前平台 1.0）"
    },
    "min_engine_api": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "max_engine_api": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "type_id": {
      "type": "string",
      "pattern": "^([a-z0-9]{2,16})/[a-z0-9][a-z0-9_.-]*$",
      "description": "G2: 前缀白名单 + 命名。core=官方签名包专用；user=任意；自定义前缀需 register_prefix 登记"
    },
    "title": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["输入", "语义", "分析", "音频", "剪辑", "输出", "控制", "用户节点"]
    },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "G3: 严格 semver（v2 必填）"
    },
    "kind": {
      "type": "string",
      "enum": ["transform", "python"],
      "description": "G4: 白名单落地；ui/hybrid 待能力评审后开放"
    },
    "runtime": {
      "type": "string",
      "enum": ["transform", "python"]
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]+\\.py$",
      "description": "kind=python 必填；路径逃逸由安装层校验（须在包目录内）"
    },
    "class_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/definitions/port" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/definitions/port" }
    },
    "params": {
      "type": "array",
      "items": { "$ref": "#/definitions/port" }
    },
    "transform": {
      "type": "object",
      "additionalProperties": true,
      "description": "G6: 输出端口名 -> op 表达式；键必须 ⊆ outputs 端口名，op 白名单由 Python 语义层递归校验"
    },
    "gpu_required": { "type": "boolean", "default": false },
    "gpu_recommended": { "type": "boolean", "default": false },
    "streaming": { "type": "boolean", "default": false },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "description": "G7: 五作用域声明，默认 deny-all",
      "properties": {
        "fs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "subprocess": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "argv_allowlist": { "type": "array", "items": { "type": "string" } }
          }
        },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "refs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vars": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "channel"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "channel": { "type": "string", "enum": ["pip", "bundle", "market"] },
          "optional": { "type": "boolean", "default": false }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "description": "G8: UI 资源声明（ui/ 目录）。entry 必须指向包内 ui/ 子树，不得逃逸",
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^(ui/)?[A-Za-z0-9_./-]+\\.(js|mjs|css)$"
        },
        "sandbox": { "type": "object" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "description": "G10: 占位 {alg, key_id, value, over}；无签名 = 社区级安装 + 警告，签名失败 = 拒绝",
      "properties": {
        "alg": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "key_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "over": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "port": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "type": {
          "type": "string",
          "enum": [
            "VIDEO", "IMAGE", "AUDIO", "SCRIPT", "SUBTITLE", "SEGMENTS",
            "TIMELINE", "JSON", "STRING", "INT", "FLOAT", "BOOL", "ANY"
          ]
        },
        "label": { "type": "string" },
        "required": { "type": "boolean", "default": true },
        "default": {},
        "widget": {
          "type": "string",
          "enum": ["text", "number", "select", "file", "toggle", "password"]
        },
        "options": {
          "type": "array",
          "items": { "type": ["string", "number"] }
        },
        "description": { "type": "string" }
      }
    }
  }
}
